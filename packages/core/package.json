{
  "name": "@volten/core",
  "version": "0.1.0",
  "description": "WebGPU compute, without the ceremony.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "webgpu",
    "gpu",
    "compute",
    "wgsl",
    "shader",
    "gpgpu",
    "typescript",
    "javascript",
    "gpu-computing",
    "compute-shaders",
    "webgpu-compute",
    "shader-debugging"
  ],
  "homepage": "https://volten-gpu.github.io/",
  "bugs": {
    "url": "https://github.com/volten-gpu/volten/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volten-gpu/volten.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "check-types:file": "tsc --noEmit --pretty false > tsc_output.txt 2>&1 || type tsc_output.txt"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.70"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^10.4.1",
    "typescript": "5.9.2"
  }
}